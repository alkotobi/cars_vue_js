# Deployment-local database binding.
# db_code.json names the database THIS deployment talks to and is written by
# deploy/deploy.sh on the server, which also excludes it from the rsync. It is
# per-machine state, not source, and the copy under public/ is only a local dev
# default - so a root-level copy should never be committed.
/db_code.json
# Root-anchored: these are the local scratch migration folders, NOT
# api/migrations/. Unanchored, 'mig*/' also swallowed api/migrations/, so every
# migration added since 020 was silently ignored by git and never committed -
# while DEPLOYMENT.md tells operators to run them by path.
/mig*/
build/
build*/

# Per-machine provisioning config: which database new clients are built from, and
# where the build is. Read only when /etc/cars-deploy.json is absent, so it is a
# development convenience - but it holds registry credentials, which is why it lives
# outside api/ rather than beside config.local.php.
deploy/cars-deploy.local.json

# Tenant folders (merhab_cars/, mig1/, ...) are provisioning output. A tenant folder
# holds only its uploads now - files/ - because the code is shared: one api/ and one
# dist/ at the root, and a tenant is named by its folder rather than by a copy of the
# application sitting beside it. Nothing under a tenant folder is source, and the
# uploads are client data that must not reach git.
#
# Named explicitly rather than by pattern, because a pattern that covered every
# one-level-deep directory would also cover api/, src/ and dist/. Root-anchored, so a
# tenant named e.g. "api" still cannot swallow the real api/ tree. Note the root
# app's own uploads in /files/ ARE tracked - that folder predates the tenant layout
# and holds source-controlled documents, so it is deliberately not matched here.
/merhab_cars/
/mig1/
/ali_cars/
/maria_cars/
/merhab_cars_files/
/mig_files_2026/

