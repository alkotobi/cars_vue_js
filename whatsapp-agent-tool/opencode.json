{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3.6:27b-ctx64",
  "small_model": "ollama/qwen3.6:27b-ctx64",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.6:27b-ctx64": {
          "name": "Qwen 3.6 27B (local, Arabic+tools)"
        },
        "gemma4:26b-ctx64": {
          "name": "Gemma 4 26B (local, fast)"
        }
      }
    }
  },
  "mcp": {
    "whatsapp": {
      "type": "local",
      "command": ["/Users/merhab/dev/cars/whatsapp-agent-tool/go/bin/whatsapp-tool", "mcp"],
      "enabled": true,
      "environment": {
        "WA_PROFILE": "{env:WA_PROFILE}"
      }
    }
  }
}