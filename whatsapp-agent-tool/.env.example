# Local MySQL for the shared "ai" database. Copy to .env and fill in (gitignored).
# The app reads these (or a single AI_DB_URL / DATABASE_URL).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ai

# Alternative single-URL form (wins over the vars above if set):
# AI_DB_URL=mysql://root:password@127.0.0.1:3306/ai

# --- Cars app stock (a SEPARATE system; see go/internal/carshttp) -------------
# Base URL of the cars app and the tenant (folder/database) to read, WITHOUT a
# trailing slash. The tenant is part of the URL path, e.g.
#   CARS_BASE_URL=https://163.245.222.142
#   CARS_TENANT=merhab_cars
# The AI logs in as its OWN dedicated user that an admin created in the app. That
# user's username/password (and the cached token) live in the OS credential store
# (Windows Credential Manager / macOS Keychain / Linux Secret Service), seeded once
# with:
#   whatsapp-tool stock creds --username <AI user> [--password <...>]
# If the store is empty `whatsapp-tool stock` prints status ERROR and asks for them.
# The login response's role + permission names are cached too; `stock` refuses to
# run unless the AI user's role grants `can_c_car_stock` (the app's stock-view
# permission). Give the AI user a restricted role with only that permission.
# CARS_BASE_URL=
# CARS_TENANT=
# Optional: pin a token directly (skips the login). The credential store is used
# automatically otherwise.
# CARS_API_TOKEN=

# --- Chat AI (whatsapp-tool chat-poll) ---------------------------------------
# The bot polls the cars-app chat tables of the CARS_TENANT database for new
# client messages, generates replies with the opencode CLI (a sandboxed agent
# whose tools are read-only `whatsapp-tool` lookups plus restricted web access)
# and posts them back as the logged-in AI user. All keys are optional.
#
# Web access: the agent may search/read the internet ONLY for company-credibility
# and car-specification questions. opencode's own webfetch is disabled; pages are
# read via `whatsapp-tool web fetch <url>`, whose domain allowlist is enforced in
# Go (internal/webfetch — `whatsapp-tool web list` prints it). Any reply that used
# the web (a `websearch` call or a `web fetch`) is stamped with a source line
# automatically. The child runs with OPENCODE_ENABLE_EXA=1 (set in code) so the
# built-in `websearch` tool is available even under a non-OpenCode model.
# CHAT_POLL_INTERVAL=5          # seconds between poll cycles (default 5)
# CHAT_MAX_REPLY_CHARS=2000     # cap on a generated reply before the AI line (default 2000)
# CHAT_AGENT=chatbot            # opencode agent name in the workdir (default "chatbot")
# CHAT_MODEL=                   # optional override of the model pinned in the workdir config
# OPENCODE_BIN=opencode         # opencode CLI binary (default "opencode")
# CHAT_WORKDIR=                 # isolated opencode project dir (default ~/.whatsapp-tool/chatbot)
# CHAT_ALERT_THROTTLE=600       # seconds between failure alarms (default 600)
# CHAT_ALARM_CMD=beep           # program run on failure (default "beep", macOS system beeps; use "say" for voice)
# CHAT_ALARM_VOICE=             # optional `say` voice (only when CHAT_ALARM_CMD=say)
