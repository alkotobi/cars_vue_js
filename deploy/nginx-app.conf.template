# Cars Management System — nginx app block
#
# Placeholders replaced by deploy/render-nginx.sh:
#   __FOLDER__       app folder name, e.g. cars, mig_26, my_client
#   __WEBROOT__      nginx web root,   e.g. /var/www/world-automobile.com
#   __SERVER_NAME__  e.g. world-automobile.com  (or an IP for a non-TLS deploy)
#   __PHP_SOCK__     e.g. /run/php/php8.5-fpm.sock
#
# Render + validate + install:
#   ./deploy/render-nginx.sh <folder> <server_name> [webroot] [php_sock]
#
# The app itself is folder-agnostic (relative Vite base, basePath resolved from
# import.meta.url). NOTHING in the built assets needs to change when the folder
# name changes — only this file.

server {
    listen 80;
    server_name __SERVER_NAME__;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name __SERVER_NAME__;

    ssl_certificate     /etc/letsencrypt/live/__SERVER_NAME__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__SERVER_NAME__/privkey.pem;

    root __WEBROOT__;
    index index.html;

    # Large uploads (contract PDFs, PI scans, backups). Must be >= php.ini
    # post_max_size (110M) or PHP silently truncates the body.
    client_max_body_size 110M;

    # Without the trailing slash the relative base resolves to "/" and the app
    # renders blank. https://host/cars -> https://host/cars/
    location = /__FOLDER__ {
        return 301 /__FOLDER__/;
    }

    # --- Hardening: exact-match rules win over the ^~ block below ----------
    # install.php creates the database from a web request. drop_all_tables.sql
    # drops it. Both must never be reachable, in ANY folder.
    location = /__FOLDER__/api/install.php        { deny all; }
    location = /__FOLDER__/api/drop_all_tables.sql { deny all; }

    # --- App block ----------------------------------------------------------
    # PHP MUST be nested inside the ^~ block. A bare
    #   location ^~ /__FOLDER__/ { try_files ...; }
    # swallows .php and serves the source as text (405 on POST) — the failure
    # that cost the original deploy.
    location ^~ /__FOLDER__/ {
        # Inject <base> into the SPA shell.
        #
        # index.html references its entry script relatively ("./index.<hash>.js")
        # and deliberately ships no <base>, so the URL resolves against the
        # *document*. That is correct only at depth 1. A deep link such as
        # /__FOLDER__/sell-bills/5 resolves "./index.<hash>.js" to
        # /__FOLDER__/sell-bills/index.<hash>.js, which does not exist, so
        # try_files falls through to index.html and hands the browser HTML for
        # a script request:
        #
        #   Failed to load module script: Expected a JavaScript-or-Wasm module
        #   script but the server responded with a MIME type of "text/html".
        #
        # The page 200s the whole time, so this fails as a blank tab rather than
        # an error, and it breaks every route with a path parameter. It predates
        # the folder-agnostic work; deep links were already broken.
        #
        # The folder is substituted here rather than baked into the build, so one
        # dist/ still serves any folder. sub_filter needs the ngx_http_sub_module
        # (present in the stock Ubuntu/Debian nginx). The anchor is
        # <meta charset>, which is present in every build; sub_filter_once keeps
        # it to the first match so comment prose about <base> is left alone.
        location = /__FOLDER__/index.html {
            sub_filter_once on;
            sub_filter_types text/html;
            sub_filter '<meta charset="UTF-8">' '<base href="/__FOLDER__/"><meta charset="UTF-8">';
        }

        # SPA fallback. $uri/ is deliberately NOT in this list.
        #
        # Route paths can collide with real directories on disk. The route "cars"
        # is /cars, and /cars/cars/ is a real directory holding logo.png and
        # gml2.png, so with $uri/ in the list nginx matched the directory, found
        # no index.html inside it, and returned 403 instead of the app. It looked
        # intermittent because client-side navigation never issues a request for
        # that URL; only a refresh or a pasted link reached this list.
        #
        # Dropping $uri/ means a path that is a directory but not a route falls
        # through to the SPA and the router decides. Static assets are matched by
        # the first $uri test and are unaffected.
        try_files $uri /__FOLDER__/index.html;

        # The .sql deny MUST be nested here too, not at server level. A ^~
        # prefix takes precedence over a regex location, so a `~* \.sql$` rule
        # declared outside this block is never evaluated and the schema dumps
        # are served as plain text. This exact mistake was made and caught on
        # production: the rule was present in the vhost and the files were
        # still downloadable.
        #
        # Schema dumps (export.sql, setup.sql, recreate_selection_tables.sql,
        # migrations/*.sql) disclose the full DB schema. PHP reads them from disk
        # (__DIR__), never over HTTP, and backups are generated and served by
        # backup.php, so blocking static .sql breaks no feature.
        location ~* \.sql$ { deny all; }

        location ~ \.php$ {                      # nested — runs inside ^~
            include snippets/fastcgi-php.conf;
            fastcgi_pass unix:__PHP_SOCK__;
            fastcgi_send_timeout 600;
            fastcgi_read_timeout 600;
        }

        # Hide dotfiles: .env, .git, .htaccess, .htpasswd
        location ~ /\. { deny all; }
    }
}
